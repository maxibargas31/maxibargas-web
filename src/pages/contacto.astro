---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import { availableDaysText, brand, contact, services, whatsappLink } from '../config/site';
import '../styles/pages/contacto.css';
// TODO(SEO): escribir description específica para Contacto.
---
<BaseLayout title="Contacto — Maxi Bargas">
  <PageHero eyebrow="Hablemos">Contacto</PageHero>

  <!-- CONTACTO -->
  <section id="contacto">
    <div class="wrap">
      <div class="contacto-grid">

        <!-- INFO -->
        <div data-reveal="left">
          <h2>¿Tenés dudas antes de reservar?</h2>
          <p class="contacto-intro">Escribime por WhatsApp o completá el formulario y te respondo a la brevedad. Si no sabés bien por qué servicio empezar, contame brevemente qué te pasa — te oriento sin compromiso.</p>

          <div class="info-items">
            <div class="info-item">
              <div class="info-icon" aria-hidden="true">📱</div>
              <div class="info-text">
                <h4>WhatsApp</h4>
                <a href={whatsappLink()} target="_blank" rel="noopener">{contact.whatsapp.display}</a>
              </div>
            </div>
            <div class="info-item">
              <div class="info-icon" aria-hidden="true">📧</div>
              <div class="info-text">
                <h4>Email</h4>
                <a href={`mailto:${contact.email}`}>{contact.email}</a>
              </div>
            </div>
            <div class="info-item">
              <div class="info-icon" aria-hidden="true">📍</div>
              <div class="info-text">
                <h4>Ubicación</h4>
                <p>{brand.city} · {brand.country}</p>
              </div>
            </div>
            <div class="info-item">
              <div class="info-icon" aria-hidden="true">📅</div>
              <div class="info-text">
                <h4>Disponibilidad</h4>
                <p>{availableDaysText()}</p>
              </div>
            </div>
          </div>
        </div>

        <!-- FORM: no envía datos a ningún servidor; arma un mensaje y abre WhatsApp -->
        <div data-reveal="right">
          <div class="contacto-form-wrap">
            <div class="form-header">
              <h3>Enviame un mensaje</h3>
              <p>Te respondo a la brevedad.</p>
            </div>
            <form id="form-contacto">
              <div class="form-double">
                <div class="form-group">
                  <label class="form-label" for="nombre">Nombre</label>
                  <input class="form-input" type="text" id="nombre" placeholder="Tu nombre" autocomplete="name" required />
                </div>
                <div class="form-group">
                  <label class="form-label" for="email">Email (opcional)</label>
                  <input class="form-input" type="email" id="email" placeholder="tu@correo.com" autocomplete="email" />
                </div>
              </div>
              <div class="form-group">
                <label class="form-label" for="motivo">Motivo de contacto</label>
                <div class="form-select-wrap">
                  <select class="form-select" id="motivo" required>
                    <option value="" disabled selected>Seleccioná una opción</option>
                    <option value={services.masaje.name}>{services.masaje.name}</option>
                    <option value={services.kine4life.name}>{services.kine4life.name} ({services.kine4life.duration})</option>
                    <option value={services.cuerpoActivo.name}>{services.cuerpoActivo.name} (adultos mayores)</option>
                    <option value="Consulta general">Consulta general</option>
                  </select>
                </div>
              </div>
              <div class="form-group">
                <label class="form-label" for="mensaje">Mensaje</label>
                <textarea class="form-textarea" id="mensaje" rows="5" placeholder="Contame tu consulta..." required></textarea>
              </div>
              <button type="submit" class="btn-submit">Enviar por WhatsApp</button>
            </form>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- EXTRA INFO -->
  <section id="extra">
    <div class="wrap">
      <div class="extra-grid" data-stagger>
        <div class="extra-item">
          <span class="extra-icon" aria-hidden="true">🤲</span>
          <h3>{services.masaje.name}</h3>
          <p>Sesión de {services.masaje.duration} para el dolor que vuelve siempre. Reservá directo en el calendario.</p>
        </div>
        <div class="extra-item">
          <span class="extra-icon" aria-hidden="true">📈</span>
          <h3>{services.kine4life.name}</h3>
          <p>Proceso de {services.kine4life.duration} para pasar del dolor a un cuerpo funcional. Escribime para coordinar.</p>
        </div>
        <div class="extra-item">
          <span class="extra-icon" aria-hidden="true">🏃</span>
          <h3>{services.cuerpoActivo.name}</h3>
          <p>Movimiento y fuerza funcional para adultos mayores. Completá la evaluación inicial para empezar.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { whatsappLink } from '../config/site';

  const form = document.getElementById('form-contacto') as HTMLFormElement | null;
  const val = (id: string) => (document.getElementById(id) as HTMLInputElement | null)?.value.trim() ?? '';

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const email = val('email');
    const texto =
      `Hola Maxi! Te escribo desde el sitio web 🌿\n\n` +
      `👤 Nombre: ${val('nombre')}\n` +
      (email ? `📧 Email: ${email}\n` : '') +
      `📌 Motivo: ${val('motivo')}\n` +
      `\n💬 Mensaje:\n${val('mensaje')}`;
    window.open(whatsappLink(texto), '_blank', 'noopener');
  });
</script>
