---
/* Layout del nuevo diseño Kine4Life (V2). Por ahora solo lo usa la Home. */
import SEO from '../components/layout/SEO.astro';
import HeaderV2 from '../components/v2/HeaderV2.astro';
import FooterV2 from '../components/v2/FooterV2.astro';
import '../styles/v2/tokens.css';
import '../styles/v2/base.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  schema?: boolean;
}

const props = Astro.props;
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script is:inline>document.documentElement.classList.add('js');</script>
  <SEO {...props} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta name="theme-color" content="#1c3f30" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&family=Instrument+Sans:wght@400..700&display=swap" />
</head>
<body>
  <a href="#contenido" class="skip-link">Saltar al contenido</a>
  <HeaderV2 />
  <main id="contenido">
    <slot />
  </main>
  <FooterV2 />

  <script>
    import '../scripts/nav';
    import '../scripts/reveal';
  </script>
</body>
</html>
